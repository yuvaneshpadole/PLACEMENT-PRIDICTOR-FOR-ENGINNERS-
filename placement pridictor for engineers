                            topMargin=36, bottomMargin=36)
    styles = getSampleStyleSheet()
    story = []

    story.append(Paragraph("AI Student Placement Prediction Report", styles["Title"]))
    story.append(Spacer(1, 12))
    story.append(Paragraph(
        f"Generated on: {datetime.now().strftime('%d %B %Y, %I:%M %p')}",
        styles["Normal"]
    ))
    story.append(Spacer(1, 15))

    data = [
        ["Student", str(student.get("name", ""))],
        ["Branch", str(student.get("branch", ""))],
        ["College", str(student.get("college", ""))],
        ["CGPA", str(student.get("cgpa", ""))],
        ["10th %", str(student.get("tenth", ""))],
        ["12th %", str(student.get("twelfth", ""))],
        ["Backlogs", str(student.get("backlogs", ""))],
        ["Coding", f"{student.get('coding', '')}/10"],
        ["Communication", f"{student.get('communication', '')}/10"],
        ["Aptitude", f"{student.get('aptitude', '')}/10"],
        ["Projects", str(student.get("projects", ""))],
        ["Internship", "Yes" if student.get("internship") else "No"],
        ["Certifications", str(student.get("certifications", ""))],
        ["AI Readiness Score", f"{ai_score}/100"],
        ["Placement Probability", f"{prediction['probability']}%"],
        ["Prediction", prediction["label"]],
    ]

    table = Table(data, colWidths=[180, 300])
    table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
        ("BACKGROUND", (0, 0), (0, -1), colors.lightgrey),
        ("FONTNAME", (0, 0), (0, -1), "Helvetica-Bold"),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("PADDING", (0, 0), (-1, -1), 7),
    ]))
    story.append(table)
    story.append(Spacer(1, 18))

    story.append(Paragraph("Personalized Suggestions", styles["Heading2"]))
    for item in suggestions:
        story.append(Paragraph("• " + item, styles["Normal"]))
        story.append(Spacer(1, 5))

    story.append(Spacer(1, 15))
    story.append(Paragraph(
        "Note: This report is an educational prediction/assessment and does not guarantee actual placement.",
        styles["Italic"]
    ))

    doc.build(story)
    buffer.seek(0)
    return buffer

def get_suggestions(student, probability, ai_score):
    suggestions = []

    if student["cgpa"] < 7:
        suggestions.append("Try to improve your CGPA because academic performance can affect eligibility for some companies.")
    if student["coding"] < 7:
        suggestions.append("Improve programming fundamentals and practice coding problems regularly.")
    if student["communication"] < 7:
        suggestions.append("Practice speaking, self-introduction and mock HR interviews.")
    if student["aptitude"] < 7:
        suggestions.append("Practice quantitative aptitude, logical reasoning and verbal questions.")
    if student["projects"] < 2:
        suggestions.append("Build at least 2 strong projects and be ready to explain your contribution.")
    if not student["internship"]:
        suggestions.append("Try to gain practical experience through an internship, training or real-world project.")
    if student["backlogs"] > 0:
        suggestions.append("Clear pending backlogs and check company eligibility criteria.")
    if student["certifications"] < 2:
        suggestions.append("Consider completing relevant certifications in your target technology.")
    if ai_score < 70:
        suggestions.append("Complete the AI interview assessment again after improving technical and communication skills.")

    if not suggestions:
        suggestions.append("Your profile is balanced. Continue practicing coding, aptitude and mock interviews.")

    if probability >= 75:
        suggestions.append("Your overall readiness is strong. Focus on company-specific preparation and interview practice.")
    elif probability >= 50:
        suggestions.append("Your profile has moderate readiness. Work on the weak areas above before placement season.")
    else:
        suggestions.append("Focus on your fundamentals first and retake the assessment after making improvements.")

    return suggestions

def chatbot_reply(message):
    text = message.lower()

    if any(x in text for x in ["hello", "hi", "hey"]):
        return "Hello! 👋 Tell me about your skills, projects or placement preparation."

    if "python" in text or "java" in text or "c++" in text:
        return "Good! Programming is important for technical placements. Tell me your programming level from 1 to 10 and one project you made."

    if "interview" in text:
        return "For interviews, prepare your self-introduction, projects, OOP, DBMS, SQL, DSA basics and common HR questions."

    if "dsa" in text or "data structure" in text:
        return "Start with arrays, strings, linked lists, stacks, queues, searching, sorting, trees and basic time complexity."

    if "communication" in text:
        return "Practice speaking for 5–10 minutes daily. Record yourself answering 'Tell me about yourself' and improve clarity and confidence."

    if "project" in text:
        return "A strong project should have a clear problem, dataset, technology, implementation, result and your personal contribution."

    if "placement" in text or "job" in text:
        return "Placement readiness depends on academics, technical skills, aptitude, communication, projects, internships and interview performance."

    if "cgpa" in text:
        return "A good CGPA helps with eligibility, but practical skills, projects, coding and communication are also important."

    return "I understand. 👍 Try telling me about your technical skills, project experience, coding level or interview preparation, and I will guide you."

