@st.cache_resource
def train_demo_model():
    rng = np.random.default_rng(42)
    n = 1200

    cgpa = rng.uniform(4.5, 10.0, n)
    tenth = rng.uniform(45, 100, n)
    twelfth = rng.uniform(45, 100, n)
    backlogs = rng.integers(0, 5, n)
    coding = rng.integers(1, 11, n)
    communication = rng.integers(1, 11, n)
    aptitude = rng.integers(1, 11, n)
    projects = rng.integers(0, 6, n)
    internship = rng.integers(0, 2, n)
    certifications = rng.integers(0, 7, n)

    score = (
        0.30 * cgpa
        + 0.08 * (tenth / 10)
        + 0.08 * (twelfth / 10)
        - 0.10 * backlogs
        + 0.12 * coding
        + 0.10 * communication
        + 0.09 * aptitude
        + 0.06 * projects
        + 0.05 * internship
        + 0.02 * certifications
    )

    threshold = np.median(score)
    y = (score >= threshold).astype(int)

    X = pd.DataFrame({
        "cgpa": cgpa,
        "tenth": tenth,
        "twelfth": twelfth,
        "backlogs": backlogs,
        "coding": coding,
        "communication": communication,
        "aptitude": aptitude,
        "projects": projects,
        "internship": internship,
        "certifications": certifications,
    })

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    model = RandomForestClassifier(
        n_estimators=250,
        random_state=42,
        max_depth=8,
        class_weight="balanced",
    )
    model.fit(X_train, y_train)
    accuracy = accuracy_score(y_test, model.predict(X_test))
    return model, accuracy

model, model_accuracy = train_demo_model()

